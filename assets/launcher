#!/bin/bash
DIR="$(cd "$(dirname "$0")" && pwd)"
RES="$(cd "$DIR/../Resources" && pwd)"
cd "$RES"
export MW2_BOTS=7
export DYLD_INSERT_LIBRARIES="$DIR/midas_shim.dylib"
for icd in /opt/homebrew/opt/molten-vk/etc/vulkan/icd.d/MoltenVK_icd.json /usr/local/opt/molten-vk/etc/vulkan/icd.d/MoltenVK_icd.json; do
    if [ -f "$icd" ]; then export VK_ICD_FILENAMES="$icd"; break; fi
done
exec "$DIR/mw2mp" "$RES/mp_exec" "$RES/game" +set sv_maxclients 18 +set party_maxplayers 18 +set ui_maxclients 18 +set com_maxfps 60 +set r_vsync 1
