#!/bin/bash
DIR="$(cd "$(dirname "$0")" && pwd)"
RES="$(cd "$DIR/../Resources" && pwd)"
SAVE_DIR="$HOME/Documents/MW2 Save"
mkdir -p "$SAVE_DIR"
if [ -d "$RES/saves" ] && [ ! -L "$RES/saves" ]; then
    cp -Rn "$RES/saves/." "$SAVE_DIR/" 2>/dev/null || true
    rm -rf "$RES/saves"
fi
ln -sfn "$SAVE_DIR" "$RES/saves"
cd "$RES"
export MW2_BOTS=7
export DYLD_INSERT_LIBRARIES="$DIR/midas_shim.dylib"
export MVK_CONFIG_MAX_ACTIVE_METAL_COMMAND_BUFFERS_PER_QUEUE=1
for icd in /opt/homebrew/opt/molten-vk/etc/vulkan/icd.d/MoltenVK_icd.json /usr/local/opt/molten-vk/etc/vulkan/icd.d/MoltenVK_icd.json; do
    if [ -f "$icd" ]; then export VK_ICD_FILENAMES="$icd"; break; fi
done
exec "$DIR/mw2mp" "$RES/mp_exec" "$RES/game" +set sv_maxclients 18 +set party_maxplayers 18 +set ui_maxclients 18
